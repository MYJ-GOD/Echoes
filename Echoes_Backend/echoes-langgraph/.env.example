# ==========================================
# echoes-langgraph 环境变量配置模板
# ==========================================
# 复制此文件为 .env 并填入真实值
# .env 在 .gitignore 中，不会提交到仓库

# ==========================================
# LLM 通道配置（OpenAI 兼容接口）
# ==========================================
# DeepSeek（推荐，性价比高）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# 或切换到阿里云百炼 DashScope（需改 base_url + model）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-turbo

# ==========================================
# 基础设施连接（本地运行）
# ==========================================
# Qdrant 向量数据库
QDRANT_URL=http://localhost:6333

# MongoDB（记忆备份 + 静态画像）
MONGODB_URI=mongodb://root:root@localhost:27017

# ==========================================
# HuggingFace 模型缓存
# ==========================================
# 模型统一放项目 models 目录，避免 C 盘占用
# bge-m3 (4.3G) + bge-reranker-v2-m3 (2.2G) 首次启动自动下载
HF_HOME=D:/Echoes/models/huggingface

# 如遇 HuggingFace 网络问题，可使用镜像（启动时 export）
# HF_ENDPOINT=https://hf-mirror.com

# ==========================================
# Agent 行为配置（可选，有默认值）
# ==========================================
# ReAct 循环最大迭代次数
# AGENT_MAX_ITERATIONS=3

# 记忆检索 Rerank 门禁阈值（低于此分数不注入记忆）
# AGENT_RERANK_THRESHOLD=0.5
