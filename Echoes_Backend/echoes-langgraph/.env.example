# Echoes LangGraph Service 环境变量配置
# 复制此文件为 .env 并修改相应配置

# Qdrant 配置
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Echoes-AI 服务地址
ECHOES_AI_URL=http://localhost:8000

# CORS 配置（多个用逗号分隔）
CORS_ORIGINS=["*"]

# 模型配置
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 日志配置
LOG_LEVEL=INFO
