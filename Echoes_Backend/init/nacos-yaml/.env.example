# ==================== Echoes Backend 环境变量配置示例 ====================
# 使用说明：
# 1. 复制此文件为 .env 文件
# 2. 根据实际环境修改配置值
# 3. 在启动服务前，通过以下方式之一加载环境变量：
#    - 方式 1：使用 dotenv 工具（推荐开发环境）
#    - 方式 2：在 IDE 运行配置中设置环境变量
#    - 方式 3：在命令行中使用 export（Linux/Mac）或 set（Windows）
#    - 方式 4：通过 Nacos 配置中心统一管理（推荐生产环境）
#
# 注意：生产环境请务必修改默认密码和密钥！

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=echoes
DB_USERNAME=root
DB_PASSWORD=root

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== MongoDB 配置 ====================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=echoes
MONGODB_USERNAME=root
MONGODB_PASSWORD=root

# ==================== Nacos 配置中心 ====================
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# ==================== JWT 配置 ====================
# 注意：JWT 密钥必须至少 32 字符（256 位）以确保安全性
# 生产环境建议使用随机生成的强密钥
JWT_USER_SECRET_KEY=change-me-user-secret-key-0123456789abcdef
JWT_ADMIN_SECRET_KEY=change-me-admin-secret-key-0123456789abcdef

# ==================== 阿里云 OSS 配置 ====================
# 注意：生产环境请使用 RAM 子账号 AccessKey，不要使用主账号
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=echoes-sim

# ==================== 阿里云 DashScope（百炼）配置 ====================
# API Key 获取方式：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MODEL=qwen3-max
DASHSCOPE_APP_ID=
DASHSCOPE_WORKSPACE_ID=

# ==================== Voice 服务配置 ====================
VOICE_CALLBACK_API_KEY=change-me-internal-callback-key
ECHOES_AI_BASE_DIR=D:/Echoes/Echoes_Backend/Echoes-AI
COSYVOICE_MODEL_DIR=D:/Echoes/models/cosyvoice2-0.5b
COSYVOICE_REPO_DIR=D:/Echoes/Echoes_Backend/third_party/CosyVoice
ECHOES_MODELS_DIR=D:/Echoes/models

# ==================== Qdrant 向量数据库配置 ====================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ==================== 其他配置 ====================
# 服务端口配置
SERVER_PORT_GATEWAY=18080
SERVER_PORT_USER=18081
SERVER_PORT_CONVERSATION=18082
SERVER_PORT_VOICE=18083
SERVER_PORT_ADMIN=18084
SERVER_PORT_AI=18085

# 日志级别
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_ECHOES=DEBUG
