# Echoes-AI example environment file
# Copy this file to `.env` and adjust values for your environment.

# Paths and CosyVoice configuration
COSYVOICE_REPO_DIR=D:/Echoes/Echoes_Backend/third_party/CosyVoice
ECHOES_MODELS_DIR=D:/Echoes/models
COSYVOICE_MODEL_SUBDIR=cosyvoice2-0.5b
TTS_SAMPLE_RATE=24000
PORT=18085
LOG_LEVEL=INFO

# Database (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=echoes
MYSQL_USER=root
MYSQL_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Nacos (服务发现)
# 在容器/集群中请替换为正确地址
NACOS_SERVER_ADDR=http://127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_SERVICE_NAME=echoes-ai

# 如果需要强制注册到指定 IP（开发环境），可以设置 ECHOES_AI_BIND_IP
ECHOES_AI_BIND_IP=127.0.0.1

# 默认 SFT 说话人 (.pt 文件) —— 可以是绝对路径或相对项目根的相对路径
# 示例（相对项目根）:
# DEFAULT_SFT_SPEAKER_PT=data/voice_assets/shared/narrator_female/features/narrator_female.pt
DEFAULT_SFT_SPEAKER_PT=data/voice_assets/shared/narrator_female/features/narrator_female.pt

# 其他可选配置项（示例）
# LOG_LEVEL=DEBUG
# REDIS_URL=redis://localhost:6379