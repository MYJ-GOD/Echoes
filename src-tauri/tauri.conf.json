{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Echoes",
  "version": "0.1.0",
  "identifier": "com.myjgod.echoes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run sidecar:build"
  },
  "app": {
    "windows": [
      {
        "title": "Echoes",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Echoes",
    "shortDescription": "离线语音陪伴",
    "longDescription": "声音与记忆留在本机；LLM 可选本地 Ollama 或云端 API。",
    "category": "Productivity",
    "resources": {
      "../sidecar/dist/echoes-sidecar/": "sidecar/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
